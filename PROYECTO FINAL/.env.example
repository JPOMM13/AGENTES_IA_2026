LLM_ENABLED=true

# Valores soportados: ollama, openai, anthropic
LLM_PROVIDER=ollama

# Ollama local
LLM_MODEL=llama3.2:latest
LLM_HOST=http://127.0.0.1:11434

# Para OpenAI o Anthropic puedes usar LLM_API_KEY.
# Tambien se respetan OPENAI_API_KEY y ANTHROPIC_API_KEY si existen.
LLM_API_KEY=

LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=350
LLM_TIMEOUT_SECONDS=30

# Generacion multimodal de imagen del evento cotizado.
# Para Ollama local no se requiere key en texto, pero para imagenes esta POC usa OpenAI Images.
IMAGE_GENERATION_ENABLED=false
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1
IMAGE_API_KEY=
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=high
IMAGE_TIMEOUT_SECONDS=60
