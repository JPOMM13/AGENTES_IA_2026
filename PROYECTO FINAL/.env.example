LLM_ENABLED=true

# Proveedor operativo del proyecto: openai
LLM_PROVIDER=openai

# OpenAI
LLM_MODEL=gpt-4o-mini
LLM_HOST=

# Para OpenAI puedes usar LLM_API_KEY.
# Tambien se respeta OPENAI_API_KEY si existe.
LLM_API_KEY=sk-tu-api-key

LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=350
LLM_TIMEOUT_SECONDS=30

# Observabilidad con LangSmith.
# Para activar trazas, coloca LANGSMITH_TRACING=true y tu API key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=workflow-agentico-cotizador-eventos
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Fuente de datos de negocio.
# postgres = usa las tablas jpomm_* en la base eventos.
# mock = modo desarrollo local con app/data/datos_mock.py y app/data/mock_calendario_eventos.json.
BUSINESS_DATA_SOURCE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eventos
POSTGRES_SCHEMA=negocio
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_password

# Memoria persistente entre conversaciones.
# postgres = usa memory.jpomm_memoria_cotizaciones con JSONB.
# mock = usa app/data/mock_session_memory.json.
MEMORY_DATA_SOURCE=postgres
POSTGRES_MEMORY_SCHEMA=memory

# Memoria corta de sesiones activas.
# redis = usa Redis real por id_sesion con TTL.
# mock = usa app/data/mock_redis_session.json.
SESSION_STORE=redis
REDIS_URL=redis://default:tu_password@tu_host:6379
REDIS_SESSION_TTL_SECONDS=86400

# Si tu PostgreSQL exige SSL o certificado cliente, completa estos valores.
# Para servidores que solo exigen cifrado suele bastar: POSTGRES_SSLMODE=require
# Si exige certificado cliente, usa verify-full y rutas absolutas a los certificados.
POSTGRES_SSLMODE=
POSTGRES_SSLROOTCERT=
POSTGRES_SSLCERT=
POSTGRES_SSLKEY=

# Generacion multimodal de imagen del evento cotizado.
# La generacion de imagenes usa OpenAI Images.
IMAGE_GENERATION_ENABLED=false
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1
IMAGE_API_KEY=
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=high
IMAGE_TIMEOUT_SECONDS=60

# RAG real: embeddings con OpenAI y busqueda vectorial en Supabase (rag.match_chunks).
# EMBEDDING_MODEL debe ser el mismo con el que se ingestaron los chunks.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
SUPABASE_URL=
SUPABASE_KEY=
RAG_THRESHOLD=0.25
