# Todos los modelos ejecutan localmente. No se requieren API keys.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
SECURITY_SIMULATOR_MODEL=llama3.2:latest
SECURITY_JUDGE_MODEL=llama3.2:latest
SECURITY_CALL_SECONDS=90
SECURITY_TURN_SECONDS=240
SECURITY_OUTPUT_TOKENS=1200
SECURITY_MAX_CAMPAIGN_CALLS=500
SECURITY_MAX_CAMPAIGN_OUTPUT_TOKENS=600000
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
DEEPTEAM_TELEMETRY_OPT_OUT=YES
DEEPEVAL_TELEMETRY_OPT_OUT=YES
EVAL_REFERENCE_DATETIME=2026-09-06T20:00:00-05:00
